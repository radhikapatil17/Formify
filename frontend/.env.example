# ==============================================================================
# FORMIFY FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# For production deployment on Netlify, set these environment variables
# under Site Settings > Environment Variables in the Netlify Dashboard.

# ------------------------------------------------------------------------------
# 1. API BACKEND URL
# ------------------------------------------------------------------------------
# The full HTTPS URL of your deployed FastAPI backend service on Render
VITE_API_URL=https://formify-api.onrender.com

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH CLIENT ID (Optional)
# ------------------------------------------------------------------------------
# Google OAuth Client ID for the Google Sign-In button component
VITE_GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
