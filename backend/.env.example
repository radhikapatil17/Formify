# ==============================================================================
# FORMIFY BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# For production deployment on Render, configure these environment variables
# under Environment Variables in the Render Dashboard.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<ep-instance>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/formify_db?sslmode=require

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Generate a secret key using: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_hex_string_32_chars_or_more
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. FRONTEND & CORS ORIGIN CONFIGURATION
# ------------------------------------------------------------------------------
# The URL of your deployed Netlify frontend (used for email resume links & CORS)
FRONTEND_URL=https://your-app-name.netlify.app
ALLOWED_ORIGINS=https://your-app-name.netlify.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. AI FEATURES (Google Gemini API Key)
# ------------------------------------------------------------------------------
# Required for AI Form Builder, AI Doctor, Response Simulator, AI Insights, Scan-to-Fill
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH SIGN-IN (Optional)
# ------------------------------------------------------------------------------
# Google OAuth Client ID matching your Google Cloud Console Web Application credential
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL DISPATCH (Optional - for Email Invites, OTP & Resumes)
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Formify Studio
